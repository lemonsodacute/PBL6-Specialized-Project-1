DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_proctoring
# Generate a unique value with secrets.token_urlsafe(48); never reuse this template.
JWT_SECRET=replace-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
ENVIRONMENT=development
# Opt-in geometry/quality diagnostics; disabled outside development/local/test.
CARD_FACE_DEBUG=false
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
# MSSV may contain letters. Set numeric only for deployments with numeric IDs.
STUDENT_CARD_CODE_CHARSET=alphanumeric

# Shared Gemini Developer API connection (OpenAI-compatible, Free Tier project).
# Create a Gemini key in Google AI Studio; key stays only in backend/.env.
# Without a key, document import and reviewed support KB remain available.
QUESTION_GENERATION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
QUESTION_GENERATION_API_KEY=
QUESTION_GENERATION_MODEL=gemini-3.5-flash-lite
# Enable only after checking that the selected question model accepts images.
QUESTION_GENERATION_SUPPORTS_VISION=true
QUESTION_GENERATION_TIMEOUT=90

# Model-only override. Empty falls back to QUESTION_GENERATION_MODEL.
SUPPORT_ASSISTANT_MODEL=gemini-3.5-flash-lite
# Support reuses the BASE_URL/API_KEY and transport above, with its own KB/prompt.
SUPPORT_AI_TIMEOUT=25
SUPPORT_AI_PER_MINUTE=6
SUPPORT_AI_PER_DAY=100

# Online classrooms. Set room.auto_create=false on the LiveKit SFU.
# Public URL must be reachable from browsers; credentials stay on this server.
LIVEKIT_URL=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Opt-in recording capability. A class still records only after host confirmation.
CLASS_RECORDING_ENABLED=false
LIVEKIT_EGRESS_HEALTH_URL=
LIVEKIT_EGRESS_OUTPUT_ROOT=/out
# Optional: defaults to backend/private/recordings (never a public static mount).
# RECORDING_STORAGE_ROOT=
RECORDING_RETENTION_DAYS=30
RECORDING_FRAMERATE=15
RECORDING_PLAYBACK_TTL_SECONDS=300
RECORDING_PROCESSING_TIMEOUT_SECONDS=1800

# In-exam proctor alerts: no model and no generated AI events by default.
# Independent of pre-exam Face Verification (threshold remains 0.363).
PROCTOR_MODEL_ENABLED=false
# DEV only: log numerical gaze measurements from the existing authenticated Student camera stream.
PROCTOR_GAZE_CALIBRATION=false
# Temporary metadata-only pipeline logs. Enable on backend and worker; disable after verification.
PROCTOR_DIAGNOSTICS=false
# Leave unset for the shipped local_yolo/local_gaze profiles. Set {} to select neither.
# PROCTOR_MODELS={}
PROCTOR_INGEST_KEY=
PROCTOR_MODEL_TIMEOUT=5
PROCTOR_MODEL_HEALTH_TIMEOUT_SECONDS=60
PROCTOR_INGEST_PER_MINUTE=120
# Simulator additionally requires ENVIRONMENT=development or test.
PROCTOR_SIMULATOR_ENABLED=false
